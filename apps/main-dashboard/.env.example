# ==============================================================================
# Vedora Main Dashboard - Environment Configuration Template
# ==============================================================================

# Clerk Authentication (Client & Server)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key_replace_with_actual
CLERK_SECRET_KEY=sk_test_placeholder_key_replace_with_actual

# Vedora Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1


# ==============================================================================
# Cloudflare R2 Object Storage (S3-Compatible, Zero Egress)
# ==============================================================================
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name

# Optional Public Playback / CDN Domain (e.g. pub-xxx.r2.dev or custom domain)
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxx.r2.dev