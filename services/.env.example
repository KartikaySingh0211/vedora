# ==============================================================================
# Vedora Services (NestJS Backend) - Environment Configuration Template
# ==============================================================================

# Server & Network
PORT=8080
FRONTEND_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001

# Database (Neon Serverless PostgreSQL or Local TCP PostgreSQL)
# Neon Serverless (Primary): postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
# Local PostgreSQL: postgresql://postgres:postgres@localhost:5432/vedora
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# In-Memory & Distributed Cache / Queues (Redis 7)
# For local host Node.js runtime: REDIS_HOST=localhost
# For Docker Compose: REDIS_HOST=redis (automatically set in docker-compose.yml)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=vedorasecret

# Security & API Key HMAC Digest Indexing
# Must be a 32+ character random hex or base64 secret used to derive cache keys
API_KEY_DIGEST_SECRET=vedora_development_digest_secret_key_change_in_production

# User Authentication (Clerk)
CLERK_SECRET_KEY=sk_test_placeholder_key_replace_with_actual
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key_replace_with_actual

# Cloudflare R2 Object Storage (S3-Compatible, Zero Egress)
# Primary storage for direct video chunk ingestion, transcoding storage, and HLS streaming
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional Public Playback URL (e.g. https://pub-xxx.r2.dev or custom domain https://media.yourdomain.com)
R2_PUBLIC_URL=
STORAGE_CDN_URL=

# Asynchronous Transcoding & Media Processing (FFmpeg)
# Secret used for HMAC-SHA256 signature verification on transcoding callbacks (required in production; minimum 32 chars)
TRANSCODER_WEBHOOK_SECRET=your_32_character_transcoder_webhook_secret_here
# In Docker, FFmpeg and FFprobe are preinstalled at /usr/bin/ffmpeg and /usr/bin/ffprobe.
# For local bare-metal execution, defaults to system PATH or @ffmpeg-installer binaries.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Technical Ingestion Safeguards (Configurable Limits)
# MAX_FILE_SIZE_BYTES=10737418240  # 10 GiB per file default
# USER_STORAGE_CAP_BYTES=536870912000 # 500 GiB user active storage cap default
