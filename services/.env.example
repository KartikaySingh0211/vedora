# ==============================================================================
# Vedora Services (NestJS Backend) - Environment Configuration Template
# ==============================================================================

# Server & Network
PORT=8080
FRONTEND_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001

# Database (Neon PostgreSQL Pooler)
# Reuse your existing DATABASE_URL (never overwrite or expose production connection strings)
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# In-Memory & Distributed Cache / Queues (Redis 7)
# Runs via Docker Compose (services/docker-compose.yml) or falls back safely to Neon DB
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=vedorasecret

# Security & API Key HMAC Digest Indexing
# Must be a 32+ character random hex or base64 secret used to derive cache keys
API_KEY_DIGEST_SECRET=vedora_development_digest_secret_key_change_in_production

# User Authentication (Clerk)
CLERK_SECRET_KEY=sk_test_placeholder_key_replace_with_actual
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key_replace_with_actual

# Cloud Storage Ingestion (OneMinute Cloud Storage)
ONEMINUTECLOUD_API_KEY=omc_live_placeholder_key
ONEMINUTECLOUD_BUCKET_ID=00000000-0000-0000-0000-000000000001
ONEMINUTECLOUD_BASE_URL=https://api.oneminutecloud.com/api/v1
# Optional custom CDN domain for public playback streams
STORAGE_CDN_URL=https://cdn.vedora.com

# Asynchronous Transcoding Webhook
# Secret used for HMAC-SHA256 signature verification on transcoding completion callbacks
TRANSCODER_WEBHOOK_SECRET=vedora_transcoder_default_webhook_secret_32b

# Billing & Subscriptions (Stripe)
# If left blank or set to placeholder, the billing module runs in safe zero-charge mode
STRIPE_SECRET_KEY=sk_test_placeholder_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_stripe_webhook_secret
