# ==============================================================================
# Vedora Environment Configuration
# ==============================================================================

# Backend Services (services/.env)
PORT=8080
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
API_KEY_DIGEST_SECRET=your_32_character_hex_hmac_secret_key_here

# Clerk Authentication (Server & Frontend)
CLERK_SECRET_KEY=sk_test_example
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_example

# Frontend Dashboard (apps/main-dashboard/.env)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
ONEMINUTECLOUD_API_KEY=omc_live_example_api_key
ONEMINUTECLOUD_BUCKET_ID=00000000-0000-0000-0000-000000000001
